# Copy this file TWICE:
#   copy .env.example .env             (project root: used by "docker compose" for the database)
#   copy .env.example backend\.env     (used by the backend)
# Never commit the real .env files. Values below are examples.

# ---- database (docker compose reads these four) ----
DB_USER=flood
DB_PASSWORD=CHANGE_ME
DB_NAME=flood_db
POSTGIS_IMAGE=pgrouting/pgrouting-extra:16-3.5-4.0

# ---- backend (use the same password as DB_PASSWORD above) ----
DATABASE_URL=postgresql://flood:CHANGE_ME@localhost:5433/flood_db
JWT_SECRET=                      # REQUIRED, 32+ chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:5173

# gnn = the real model ;  mock = fake numbers, no torch needed (UI work / demos)
MODEL_PROVIDER=gnn
# MODEL_PATH=C:\full\path\to\ml\checkpoints_v2\best_model.pt   (optional: the default is the fine-tuned model ml/checkpoints_v3/best_model_v3.pt; set this to use another file, e.g. the older v2)

# One tick = one 5-minute model step. 5 s = fast demo clock; 300 = real time.
INFERENCE_INTERVAL_SECONDS=5
STALE_AFTER_SECONDS=30

# First login. Used ONLY when the users table is empty; delete these two lines after the first start.
BOOTSTRAP_ADMIN_ID=MUNI_ADMIN
BOOTSTRAP_ADMIN_PASSWORD=        # 10+ chars
